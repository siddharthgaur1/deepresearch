# --- App ---
API_KEY=dev-key
ENVIRONMENT=development

# --- Database ---
DATABASE_URL=postgresql+asyncpg://deepresearch:deepresearch@postgres:5432/deepresearch
DATABASE_URL_SYNC=postgresql+psycopg://deepresearch:deepresearch@postgres:5432/deepresearch

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Celery / RabbitMQ ---
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- LLM (free/local by default via Ollama; set keys below to use a paid provider) ---
LLM_MODEL=ollama/llama3.1
OLLAMA_BASE_URL=http://ollama:11434
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# --- Search (DuckDuckGo is free/no-key and used by default) ---
SEARCH_PROVIDER=duckduckgo
# TAVILY_API_KEY=
# SERPAPI_API_KEY=

# --- Embeddings (free/local via Ollama by default) ---
EMBEDDING_MODEL=ollama/nomic-embed-text
EMBEDDING_DIMS=768

# --- Research graph behavior ---
MAX_RETRY_DEPTH=3
MAX_SUB_QUESTIONS=8
FACT_CHECK_MIN_SOURCES=2
RATE_LIMIT_PER_MINUTE=30

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_KEY=dev-key
